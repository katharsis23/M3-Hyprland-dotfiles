{
  "schema_version": 3,
  "description": "Material 3-inspired Hyprland desktop for Debian/Ubuntu/Mint. Default mode resolves each dependency as APT-first, then a source build when it is not in the repositories. Pass --via-nix to install everything through Nix instead.",
  "policy": {
    "default_backend": "apt-then-source",
    "nix_backend": "opt-in (--via-nix, fully self-contained)",
    "one_owner_per_binary": true,
    "note": "Each package is owned by exactly one backend per run. There is no silent fallback between APT and source: if an APT package is absent it is built from source, and build failures are reported for the user to resolve."
  },
  "packages": [
    {
      "name": "quickshell",
      "required": true,
      "apt_name": null,
      "source": {
        "kind": "cmake",
        "repo": "https://github.com/quickshell-mirror/quickshell.git",
        "ref": "v0.2.1",
        "bin": "quickshell",
        "install_prefix": "/usr/local",
        "apt_build_deps": [
          "cmake",
          "ninja-build",
          "g++",
          "pkg-config",
          "qt6-base-dev",
          "qt6-declarative-dev",
          "qt6-wayland-dev",
          "wayland-protocols",
          "libpipewire-0.3-dev",
          "libdbus-1-dev",
          "libxkbcommon-dev"
        ]
      },
      "nix_attr": "quickshell",
      "reason": "Desktop shell. Not packaged in Debian/Ubuntu/Mint, so default mode builds it from source with the distro Qt; --via-nix uses the Nix build."
    },
    {
      "name": "hyprland",
      "required": true,
      "apt_name": "hyprland",
      "source": null,
      "nix_attr": "hyprland",
      "reason": "Compositor. Prefer the APT package (Ubuntu 24.04+/Mint 22 universe). Source build is intentionally not attempted here because it is a fragile multi-dependency build; use --via-nix when no APT package is available."
    },
    {
      "name": "matugen",
      "required": true,
      "apt_name": null,
      "source": {
        "kind": "cargo",
        "repo": "https://github.com/InioX/matugen.git",
        "bin": "matugen",
        "install_args": ["--root", "/usr/local"],
        "apt_build_deps": [
          "cargo",
          "rustc"
        ]
      },
      "nix_attr": "matugen",
      "reason": "Wallpaper-driven Material 3 palette generation. Usually absent from APT repositories; built from source with Cargo."
    },
    {
      "name": "kitty",
      "required": true,
      "apt_name": "kitty",
      "source": null,
      "nix_attr": "kitty",
      "reason": "Terminal emulator."
    },
    {
      "name": "fish",
      "required": true,
      "apt_name": "fish",
      "source": null,
      "nix_attr": "fish",
      "reason": "Interactive shell."
    },
    {
      "name": "nemo",
      "required": true,
      "apt_name": "nemo",
      "source": null,
      "nix_attr": "nemo",
      "reason": "File manager; integrates well with Mint."
    },
    {
      "name": "fuzzel",
      "required": true,
      "apt_name": "fuzzel",
      "source": null,
      "nix_attr": "fuzzel",
      "reason": "Application launcher bound to SUPER+Space in shortcuts.lua."
    },
    {
      "name": "libnotify",
      "required": true,
